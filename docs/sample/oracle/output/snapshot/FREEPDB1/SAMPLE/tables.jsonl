le":"PARKING_SPOT","referenceColumns":["PARKING_SPOT_ID"],"cardinality":"OPTIONAL_ONE_TO_ONE"}],"triggers":[{"name":"TRG_EMPLOYEE_AUDIT","timing":"AFTER","events":["INSERT","UPDATE","DELETE"],"orientation":"ROW","definition":"CREATE OR REPLACE TRIGGER sample.trg_employee_audit after insert or update or delete on sample.employee for each row","body":"declare\n    v_action varchar2(10);\nbegin\n    v_action := case when inserting then 'INSERT' when updating then 'UPDATE' else 'DELETE' end;\n    insert into sample.audit_log(table_name, record_id, action, changed_by)\n    values ('employee', coalesce(:new.employee_id, :old.employee_id), v_action, user);\nend;"},{"name":"TRG_EMPLOYEE_SET_UPDATED_AT","timing":"BEFORE","events":["UPDATE"],"orientation":"ROW","definition":"CREATE OR REPLACE TRIGGER sample.trg_employee_set_updated_at before update on sample.employee for each row","body":"begin\n    :new.updated_at := systimestamp;\nend;"}]}
{"schema":"SAMPLE","name":"EMPLOYEE_DIRECTORY_VIEW","type":"view","definition":"select\n        e.employee_id,\n        e.employee_code,\n        e.employee_name,\n        d.department_name,\n        e.status\n    from sample.employee e\n    join sample.department d on e.department_id = d.department_id","columns":[{"name":"EMPLOYEE_ID","type":"NUMBER(10,0)","precisionScale":"10","primaryKey":false,"notNull":true},{"name":"EMPLOYEE_CODE","type":"VARCHAR2(10)","precisionScale":"10","primaryKey":false,"notNull":true},{"name":"EMPLOYEE_NAME","type":"VARCHAR2(50)","precisionScale":"50","primaryKey":false,"notNull":true},{"name":"DEPARTMENT_NAME","type":"VARCHAR2(50)","precisionScale":"50","primaryKey":false,"notNull":true},{"name":"STATUS","type":"VARCHAR2(10)","precisionScale":"10","primaryKey":false,"notNull":true}],"triggers":[{"name":"TRG_EMPLOYEE_DIRECTORY_INSERT","timing":"INSTEAD OF","events":["INSERT"],"orientation":"ROW","definition":"CREATE OR REPLACE TRIGGER sample.trg_employee_directory_insert instead of insert on sample.employee_directory_view for each row","body":"declare\n    v_department_id number(10);\nbegin\n    select department_id into v_department_id\n    from sample.department\n    where department_name = :new.department_name;\n\n    insert into sample.employee(employee_code, employee_name, department_id)\n    values (:new.employee_code, :new.employee_name, v_department_id);\nend;"}],"referencedTables":[{"schema":"SAMPLE","name":"DEPARTMENT","type":"table"},{"schema":"SAMPLE","name":"EMPLOYEE","type":"table"}]}
