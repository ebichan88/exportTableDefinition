{"schema":"SAMPLE","name":"ATTENDANCE_MONTHLY_VIEW","logicalName":"部署別の月次勤務時間","type":"view","definition":"select\n        dv.department_name,\n        trunc(a.work_date, 'MM') as work_month,\n        sum(a.work_minutes) as total_minutes,\n        max(ad.note) as archive_note\n    from sample.attendance a\n    join sample.employee_directory_view dv on dv.employee_id = a.employee_id\n    left join sample_archive.department ad on ad.note = dv.department_name\n    group by dv.department_name, trunc(a.work_date, 'MM')","columns":[{"name":"DEPARTMENT_NAME","type":"VARCHAR2(50)","precisionScale":"50","primaryKey":false,"notNull":true},{"name":"WORK_MONTH","type":"DATE","primaryKey":false,"notNull":false},{"name":"TOTAL_MINUTES","type":"NUMBER","primaryKey":false,"notNull":false},{"name":"ARCHIVE_NOTE","type":"VARCHAR2(50)","precisionScale":"50","primaryKey":false,"notNull":false}],"referencedTables":[{"schema":"SAMPLE","name":"ATTENDANCE","type":"table"},{"schema":"SAMPLE","name":"EMPLOYEE_DIRECTORY_VIEW","type":"view"},{"schema":"SAMPLE_ARCHIVE","name":"DEPARTMENT","type":"table"}]}
