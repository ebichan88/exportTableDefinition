<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE project>
<!-- statusはlog4j自身の警告（ログファイルを作れない等）を標準エラーへ出すレベル。offにすると、ログが残らないことに気付けない -->
<Configuration status="warn">

	<Properties>
		<!-- このツールのログのレベル。調査時は -Dexport-table-definition.log.level=debug（実行したSQL）や
			trace（取得した行）を指定して上げる（READMEの「ログ」の節） -->
		<Property name="level">${sys:export-table-definition.log.level:-info}</Property>
		<!-- %enc{%m}{CRLF}はメッセージ中の改行を\r・\nへ置き換える。DB由来の文字列（関数の定義等）に含まれる改行で、
			偽のログ行を作られないようにするため -->
		<Property name="format">%d{yyyy/MM/dd HH:mm:ss.SSS} [%t] %-5p %c{1} %enc{%m}{CRLF}%n</Property>
		<Property name="logfile">./var/log/exportTableDefinition.log</Property>
		<Property name="logfile-archive">./var/log/exportTableDefinition_%d{yyyy-MM-dd}-%i.log</Property>
	</Properties>

	<Appenders>
		<!-- 利用者が確認すべき警告（WARN）をコンソール（標準エラー出力）へ出す設定。
			処理結果・失敗の報告はFailureReporter等が標準出力へ直接出すため、ERROR以上は出さない -->
		<Console name="warning" target="SYSTEM_ERR">
			<LevelRangeFilter minLevel="WARN" maxLevel="WARN" onMatch="ACCEPT" onMismatch="DENY" />
			<PatternLayout pattern="[warn]:%enc{%m}{CRLF}%n" />
		</Console>

		<RollingFile name="logfile" append="true"
			fileName="${logfile}" filePattern="${logfile-archive}">
			<PatternLayout pattern="${format}" />
			<Policies>
				<SizeBasedTriggeringPolicy size="10000KB" />
			</Policies>
			<DefaultRolloverStrategy max="3" />
		</RollingFile>
	</Appenders>

	<Loggers>
		<!-- このツールの警告のみコンソールにも出す（ライブラリの警告はログファイルのみ）。ログファイルへはRootを通じて出力される。
			MyBatisは実行したSQLをmapperのnamespace（このパッケージ配下）のロガーで、DEBUGに文、TRACEに取得した行を出す -->
		<Logger name="com.export_table_definition" level="${level}">
			<AppenderRef ref="warning" />
		</Logger>
		<!-- ライブラリ（MyBatisのコネクションプール・トランザクション等）は、通常の調査では要らないため警告以上だけを残す -->
		<Root level="warn">
			<AppenderRef ref="logfile" />
		</Root>
	</Loggers>
</Configuration>
