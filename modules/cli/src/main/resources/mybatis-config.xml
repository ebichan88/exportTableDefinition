<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
	<settings>
		<setting name="cacheEnabled" value="false"/>
		<setting name="argNameBasedConstructorAutoMapping" value="true"/>
	</settings>
	<typeAliases>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.DatabaseDto" alias="DatabaseDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.TableDto" alias="TableDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.ColumnDto" alias="ColumnDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.IndexDto" alias="IndexDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.ConstraintDto" alias="ConstraintDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.ForeignKeyDto" alias="ForeignKeyDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.TriggerDto" alias="TriggerDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.PartitionDto" alias="PartitionDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.FunctionDto" alias="FunctionDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.SequenceDto" alias="SequenceDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.TypeDto" alias="TypeDto"/>
		<typeAlias type="com.dbxray.infrastructure.db.repository.dto.ViewReferenceDto" alias="ViewReferenceDto"/>
	</typeAliases>
	<environments default="development">
		<environment id="development">
			<transactionManager type="JDBC" />
			<dataSource type="POOLED">
				<property name="driver" value="${driver}" />
				<property name="url" value="${url}" />
				<property name="username" value="${username}" />
				<property name="password" value="${password}" />
			</dataSource>
		</environment>
	</environments>
	<mappers>
		<mapper resource="mapper/postgresql/catalogMapper.xml"/>
		<mapper resource="mapper/oracle/catalogMapper.xml"/>
	</mappers>
</configuration>
